<IfModule mod_rewrite.c>
	RewriteEngine On
	RewriteBase /
	RewriteCond %{REQUEST_FILENAME} !-f
	RewriteCond %{REQUEST_FILENAME} !-d
	RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
	# Cache everything on CDN by default
	# las paginas cambian con alguna regularidad, ponemos maxage en 5 minutos
	Header set Cache-Control "public, s-maxage=300, max-age=0"

	# Cache in browser all assets
	<If "%{REQUEST_URI} =~ m#^/assets/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
	<If "%{REQUEST_URI} =~ m#^/docs/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
		<If "%{REQUEST_URI} =~ m#^/images/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
		<If "%{REQUEST_URI} =~ m#^/lottie/.*$#">
		Header set Cache-Control "public, max-age=604800"
	</If>
</IfModule>
